# =============================================================================
# BhookhMarket Mobile App (.env.example)
# Copy to apps/mobile/.env and update values
# =============================================================================

# Backend API endpoint (use local IP e.g. http://192.168.1.X:3000 for physical devices)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Razorpay Publishable Key (for customer checkout)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Maps API Key (for Map tab & store pins)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

