{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
